{
  "name": "@tahdheer/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "scripts": {
    "build:types": "tsc -p tsconfig.json --noEmit false --declaration --emitDeclarationOnly --rootDir src --outDir dist"
  },
  "publishConfig": {
    "types": "dist/index.d.ts"
  },
  "dependencies": {
    "@tahdheer/registry": "*"
  }
}
