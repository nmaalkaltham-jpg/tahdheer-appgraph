{
  "name": "tahdheer",
  "private": true,
  "version": "0.1.0",
  "description": "Tahdheer Digital Commerce OS — Arabic-first digital educational commerce platform (independent monorepo)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build:storefront": "npm run build --workspace @tahdheer/storefront",
    "dev:storefront": "npm run dev --workspace @tahdheer/storefront",
    "test:backend": "bash scripts/test-backend.sh",
    "guards": "node scripts/guards/run-all.mjs",
    "sweep": "node scripts/sweep-viewports.mjs",
    "sweep:keyboard": "node scripts/sweep-keyboard.mjs",
    "sweep:offline": "node scripts/sweep-offline.mjs",
    "sweep:contrast": "node scripts/sweep-contrast.mjs",
    "sweep:chrome": "node scripts/sweep-chrome.mjs",
    "sweep:spacing": "node scripts/sweep-viewports.mjs --text-spacing",
    "sweep:faults": "node scripts/sweep-faults.mjs",
    "sweep:extreme": "node scripts/sweep-viewports.mjs --extreme",
    "sweep:cardinality": "node scripts/sweep-viewports.mjs --cardinality=60",
    "sweep:motion": "node scripts/sweep-motion.mjs",
    "sweep:rtl": "node scripts/sweep-rtl.mjs",
    "sweep:aria": "node scripts/sweep-aria.mjs",
    "sweep:disclosure": "node scripts/sweep-disclosure.mjs",
    "sweep:forms": "node scripts/sweep-forms.mjs",
    "sweep:submit": "node scripts/sweep-submit.mjs",
    "sweep:targets": "node scripts/sweep-targets.mjs",
    "sweep:space": "node scripts/sweep-space.mjs",
    "sweep:selftest": "node scripts/sweep-selftest.mjs",
    "test:visual": "node scripts/sweep-visual.mjs",
    "e2e": "node scripts/e2e.mjs",
    "test": "npm run typecheck && npm run lint && npm run test:admin && npm run test:storefront && npm run test:scripts && npm run check:contract && npm run test:backend",
    "preview": "bash scripts/preview/run.sh",
    "preview:open": "node scripts/preview/serve.mjs",
    "export:html": "node scripts/preview/export-html.mjs",
    "check:links": "node scripts/preview/check-links.mjs",
    "check:cart": "node scripts/preview/check-cart.mjs",
    "local:up": "docker compose -f infrastructure/docker/docker-compose.local.yml up -d",
    "local:down": "docker compose -f infrastructure/docker/docker-compose.local.yml down",
    "local:reset": "docker compose -f infrastructure/docker/docker-compose.local.yml down -v && npm run local:up && sleep 12 && npm run local:migrate && npm run local:seed",
    "local:ps": "docker compose -f infrastructure/docker/docker-compose.local.yml ps",
    "local:logs": "docker compose -f infrastructure/docker/docker-compose.local.yml logs -f --tail=80",
    "local:migrate": "cd backend/laravel && php artisan migrate --force",
    "local:seed": "cd backend/laravel && php artisan db:seed --force",
    "local:fresh": "cd backend/laravel && php artisan migrate:fresh --seed --force",
    "dev:admin": "npm run dev --workspace @tahdheer/admin",
    "build:admin": "npm run build --workspace @tahdheer/admin",
    "start:admin": "npm run start --workspace @tahdheer/admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test:admin": "node --test apps/admin/lib/__tests__/",
    "test:storefront": "node --test apps/storefront/lib/__tests__/",
    "test:scripts": "node --test scripts/__tests__/",
    "openapi": "node scripts/openapi.mjs",
    "sdk": "node scripts/generate-sdk.mjs",
    "check:contract": "node scripts/openapi.mjs --check && node scripts/generate-sdk.mjs --check",
    "check:schema": "node scripts/check-schema-drift.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@tanstack/react-query": "^5.102.8",
    "fuse.js": "^7.5.0",
    "immer": "^11.1.18",
    "ky": "^2.1.0",
    "motion": "^13.2.0",
    "nuqs": "^2.10.1",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
