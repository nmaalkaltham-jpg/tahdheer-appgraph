# ─────────────────────────────────────────────────────────────────────────────
# قوالب المتغيّرات فقط — قيم فارغة عمدًا. لا تضع قيمة حقيقية في هذا الملفّ أبدًا.
# الملفّ الوحيد الذي يحمل القيم الحقيقية هو `.env.local`، وهو مُتجاهَل في git
# عبر قاعدة `.env.*` في `.gitignore` (وهذا الملفّ مستثنى بـ `!.env.example`).
# ─────────────────────────────────────────────────────────────────────────────

# ── سجلّات مكوّنات الواجهة المقيَّدة بالاعتماد ────────────────────────────────
# تفاصيل كاملة (ما هو مفتوح، ما هو مقيَّد، وكيف يُستعمل المفتاح):
#   docs/ui-system/REGISTRY-ACCESS.md

# 21st.dev — السجلّ يردّ 403 بلا مفتاح (تحقّقنا منه فعليًا).
# لا يقرؤه أيّ ملفّ متعقَّب اليوم (حُذف components.json الذي كان يشير إلى حزمة غير موجودة)؛
# يبقى لأدوات التصميم اليدويّة فقط.
# متغيّر بناء/أدوات فقط — يُمنع منعًا باتًّا بادئة NEXT_PUBLIC_ لأنّها تسرّبه للمتصفّح.
TWENTY_FIRST_API_KEY=

# React Bits Pro — طبقة مدفوعة لم تُتَح لنا؛ لم يُختبَر أي مسار مصادقة لها.
# اترك الحقل فارغًا ما لم يشترِ المالك الرخصة.
REACTBITS_LICENSE_KEY=

# Magic UI Pro — طبقة مدفوعة لم تُتَح لنا؛ لا نقطة سجلّ عامّة لها.
# اترك الحقل فارغًا ما لم يشترِ المالك الاشتراك.
MAGICUI_PRO_TOKEN=

# حساب مشغّل اللوحة المحلّيّ (AdminUserSeeder) — owner@localhost.
# كان مكتوبًا حرفيًّا في scripts/dev.sh وdocker-compose.local.yml وLOCAL-DEV.md،
# أي سرًّا متعقَّبًا في git. اضبطه هنا؛ لا قيمة افتراضيّة في أيّ مصدر متعقَّب.
# القيمة القديمة ما تزال في تاريخ git — بدِّلها ولا تُعِد استعمالها.
ADMIN_SEED_PASSWORD=

# ─── لا `SSR_CLIENT_IP_SECRET` هنا ───
#
# كان مُدخَلًا في هذا المِلَفّ يطلب سرًّا مشتركًا «لتمرير عنوان الزائر عبر
# التصيير»، ويأمر بوضع القيمة نفسها في `apps/storefront/.env.local` و
# `backend/laravel/.env` — **ولا سطر واحد في المستودع كلّه يقرؤه**. فمن
# نسخ المِلَفّ ولّد سرًّا وضبطه في موضعين لآليّةٍ لا وجود لها، ثمّ ظنّ أنّ
# عنوان الزائر محميٌّ به.
#
# وعنوان الزائر يصل فعلًا بالوكلاء الموثوقين: `bootstrap/app.php` يثق بـ
# `X-Forwarded-For` من مدياتٍ خاصّة (‏`TRUSTED_PROXIES`‏)، ويحرسه
# `TrustedProxyTest` بأنّ مصدرًا غير موثوق لا يستطيع تزوير عنوانه. فالضبط
# الصحيح هو `TRUSTED_PROXIES` لا سرٌّ مشترك.

# ─── Tap Payments — عقد البيئة ───
# وضعٌ واحد ومفاتيحُه؛ وضعُ تجربةٍ بمفتاح إنتاج (أو العكس) يُسقط إقلاع الواجهة الخلفيّة.
# القيم في البيئة وحدها — لا في الشيفرة ولا في الوثائق ولا في الاختبارات.
TAP_MODE=test
TAP_MERCHANT_ID=68052232
TAP_TEST_SECRET_KEY=
TAP_TEST_PUBLIC_KEY=
TAP_LIVE_SECRET_KEY=
TAP_LIVE_PUBLIC_KEY=
TAP_WEBHOOK_SECRET=
