{
  "name": "@tahdheer/admin",
  "version": "0.1.0",
  "private": true,
  "description": "لوحة تشغيل التحاضير الحديثة — إدارة العمليات والتحليلات والبحث والكتالوج",
  "scripts": {
    "dev": "next dev --port 3001",
    "dev:clean": "npm run clean && npm run dev",
    "build": "next build",
    "start": "next start --port 3001",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "lint": "eslint app components lib",
    "lint:fix": "eslint app components lib --fix",
    "check": "npm run typecheck && npm run lint",
    "verify": "npm run check && npm run build",
    "verify:clean": "npm run clean && npm run verify",
    "clean": "rm -rf .next",
    "doctor": "node -e \"console.log(`Node ${process.version}`); console.log(`Platform ${process.platform}/${process.arch}`)\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@tahdheer/api-sdk": "*",
    "@tahdheer/design-system": "*",
    "@tahdheer/ui": "*",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.5.0",
    "motion": "^13.2.0",
    "next": "^16.3.3",
    "nuqs": "^2.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24 <27",
    "npm": ">=10"
  }
}
