# عنوان واجهة Laravel التي يمرّر إليها وسيط اللوحة (app/api/v1/[...path]).
# متغيّر خادم فقط — لا يُحقن في حزمة المتصفّح، والمتصفّح يخاطب أصل اللوحة
# وحده فلا حاجة لـ CORS ولا لكشف عنوان الواجهة الخلفية.
ADMIN_API_URL=http://localhost:8000

# حساب المشغّل يُنشأ من جهة الخادم، لا من هنا:
#   ADMIN_SEED_EMAIL=… ADMIN_SEED_PASSWORD=… \
#     php artisan db:seed --class=AdminUserSeeder
# لا توجد كلمة مرور افتراضية في الكود، والبذر يرفض العمل في الإنتاج بدونها.

# عنوان المتجر العامّ — تبنى عليه روابط «افتح في المتجر» ومعاينات الاستوديو.
STOREFRONT_URL=http://localhost:3000

# دخولٌ تلقائيّ للتطوير وحده — app/login/page.tsx يتجاهله حين NODE_ENV=production.
# NEXT_PUBLIC_* تُحقن في حزمة المتصفّح: لا تضع هنا كلمة مرور حقيقيّة أبدًا.
NEXT_PUBLIC_DEV_AUTOLOGIN=
NEXT_PUBLIC_DEV_EMAIL=
NEXT_PUBLIC_DEV_PASSWORD=

# =1 يُخرج خرائط مصدر للمتصفّح لبناء القياس وحده (apps/admin/next.config.ts · productionBrowserSourceMaps).
# يبقى فارغًا في النشر: الخرائط تكشف شيفرة اللوحة لأيّ زائر.
ATLAS_MEASURE=
