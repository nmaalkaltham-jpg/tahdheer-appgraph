# المتجر — انسخه إلى .env.local واملأ القيم. لا يُلتزَم .env.local أبدًا.

# واجهة Laravel كما يراها المتصفّح (روابط عامّة).
NEXT_PUBLIC_API_URL=http://127.0.0.1:58080
# واجهة Laravel كما يراها خادم Next.js (جلبٌ خادميّ؛ يغيب ⇒ يُستعمل العامّ).
INTERNAL_API_URL=


# سرّ مسار إبطال المخزن POST /api/revalidate — يناديه صندوق الصادر في Laravel
# (STOREFRONT_REVALIDATE_SECRET هناك يجب أن يساويه). فارغ ⇒ المسار مغلق ٥٠٣
# ويعتمد المتجر على المهلة الزمنيّة وحدها: نشرُ قائمةٍ لا يظهر قبل ستّين ثانية.
REVALIDATE_SECRET=

# أصل المتجر العامّ — تبني منه `lib/seo.ts` الروابط المعياريّة وخريطة الموقع
# والبيانات المُهيكلة. غيابه يجعلها نسبيّةً أو ناقصة، وهو عطلٌ لا يظهر في
# الصفحة بل في ما يقرؤه محرّك البحث.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# جسر المتجر → لوحة التشغيل في التذييل. فارغ ⇒ يختفي الرابط، وهو المطلوب
# في النشر العامّ.
#
# ويقرؤه فاحص الواجهة كذلك (Option+نقر في التطوير): معرّفات العقد تبقى نصًّا
# يُنسخ حين يغيب. ولا
# يُخترع أصلٌ عند غيابه — رابطٌ يقود إلى ٤٠٤ أسوأ من نصٍّ يُنسخ باليد.
# خادميٌّ لا `NEXT_PUBLIC_`: ما يحمل البادئة يُخبز في حزمة المتصفّح فيصير
# عنوان أداةٍ داخليّة سطرًا يقرؤه كلّ زائر.
ADMIN_URL=

# قنوات التواصل في صفحة «اتّصل بنا» ونتائج البحث الفارغة. كلٌّ منهما يسقط
# وحده حين يغيب: لا يُعرض رقمٌ ولا بريدٌ مخترَع.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
