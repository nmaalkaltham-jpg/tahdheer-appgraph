APP_NAME=Tahdheer
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Riyadh

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4


LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Runtime authority: PostgreSQL. Tests run on sqlite :memory: (phpunit.xml).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tahdheer
DB_USERNAME=tahdheer
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local

# Queue + cache ride on Valkey (Redis-compatible) in production.
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

# Valkey (Redis-compatible) connection.
# Production runs Valkey 9 (redis-compatible) for cache/queue/locks/rate-limits:
#   CACHE_STORE=redis  QUEUE_CONNECTION=redis  REDIS_HOST=valkey
# Local dev defaults to the database driver so the stack boots with no extra services.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"



# ─────────────────────────────────────────────────────────────
# القياس الموزَّع (OpenTelemetry)
#
# مُجمِّع OTel يعمل في compose تحت ملمح `observability` ويستقبل OTLP على
# 4317 (gRPC) و4318 (HTTP)، ويصدّر إلى Prometheus وLoki وTempo. وdocker-compose
# يمرّر `OTEL_EXPORTER_OTLP_ENDPOINT` إلى api وworker وscheduler منذ البداية —
# لكنّ المتغيّر لم يكن معرَّفًا هنا، فكان يصل **فارغًا** ولا يُصدَّر أثر واحد.
#
# فارغ = القياس معطَّل صراحةً. لا يُخمَّن عنوان: مُصدِّرٌ يشير إلى مضيف لا يوجد
# يُعلّق الطلبات في انتظار مهلته بدل أن يفشل بصمت.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=tahdheer-api
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# لا حمولات ولا أسرار في الآثار — يُفرَض في المُجمِّع بمعالج attributes/privacy،
# وهذا المفتاح يمنع إرسالها من المصدر أصلًا (دفاع في العمق).
OTEL_PHP_DISABLED_INSTRUMENTATIONS=
OTEL_ATTRIBUTE_VALUE_LENGTH_LIMIT=512

# ── المساعد الكتابيّ (مزوّد خارجيّ، اختياريّ) ───────────────────────────────
# فارغٌ يعني «غير مهيَّأ» صراحةً: الواجهة تعرض NOT_CONFIGURED ولا تتلقّى نصًّا
# مُلفَّقًا. تُقرأ في config/services.php ولم تكن موثّقةً هنا.
WRITING_PROVIDER=
WRITING_API_KEY=
WRITING_MODEL=claude-sonnet-5
WRITING_TIMEOUT=30

# ── محرّك الاستدلال المحلّيّ ────────────────────────────────────────────────
# مطفأٌ افتراضًا. إطفاؤه يترك المتجر يعمل كاملًا: الشراء والبحث والكتالوج
# والإدارة لا يعتمد أيٌّ منها على استدلالٍ ناجح.
AI_ENABLED=false

# رايةٌ لكلّ قدرة. `AI_ENABLED=false` تعلوها جميعًا.
AI_PRODUCT_ENRICHMENT=false
AI_SEARCH_ASSIST=false
AI_SEO=false
AI_OCR_ENRICHMENT=false
AI_ADMIN_COPILOT=false
AI_CUSTOMER_ASSISTANT=false
AI_RECOMMENDATIONS=false

# عنوان الخدمة على شبكة Docker الداخليّة. لا منفذ منشور، ولا يصله متصفّح:
# llama.cpp بلا مصادقةٍ ولا تحديد معدّل.
AI_BASE_URL=http://ai-llm:8081
AI_MODEL=Qwen3.5-2B-Q4_K_M
AI_MODEL_FILE=Qwen3.5-2B-Q4_K_M.gguf

# مهلتان: الاتّصال يفشل بسرعة حين تسقط الخدمة، والقراءة تحتمل طول التوليد.
AI_CONNECT_TIMEOUT=2.0
AI_TIMEOUT=60.0
AI_INTERACTIVE_TIMEOUT=12.0

# حدود المورد. الثلاثة تُطبَّق في docker compose أيضًا — طبقتان تحرسان
# بعضهما حين تفشل واحدة.
AI_CPU_THREADS=3
AI_PARALLEL_REQUESTS=1
AI_CONTEXT=4096
AI_MAX_OUTPUT_TOKENS=800
AI_MAX_INPUT_CHARS=8000
AI_MEMORY_LIMIT=3g
AI_CPU_LIMIT=3.0

# الضغط العكسيّ وتحديد المعدّل.
AI_ACTOR_RATE=20
AI_MAX_QUEUE_DEPTH=500

# قاطع الدائرة: فشلٌ متكرّر يُرَدّ فورًا بدل استنزاف عمّال PHP في المهل.
AI_BREAKER_FAILURES=5
AI_BREAKER_OPEN_SECONDS=60

# التخزين المؤقّت. المهلة إلزاميّة: Valkey يعمل بسياسة noeviction، ومفتاحٌ
# بلا مهلة يملأ الذاكرة حتّى تفشل الكتابة على المتجر كلّه.
AI_CACHE_ENABLED=true
AI_CACHE_TTL=86400

# اسم الطابور — لا بدّ من وجوده في `--queue=` لخدمة العامل وإلّا لم يُستهلك.
AI_QUEUE=ai

# منصّة العناوين — إبطال مخزن المتجر عند تغيّر رابط
STOREFRONT_REVALIDATE_URL=
STOREFRONT_REVALIDATE_SECRET=

# منصّة العناوين — حدود طول الرابط المولَّد (SlugEngine). الافتراضان ١ و٨٠.
URL_SLUG_MIN=
URL_SLUG_MAX=

# مهلة روابط الأصول الموقَّعة بالثواني (config/filesystems.php).
ASSETS_URL_TTL_SECONDS=
